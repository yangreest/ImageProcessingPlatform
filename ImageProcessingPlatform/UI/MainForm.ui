          <string notr="true">/* 普通未选中按钮 */
QPushButton{
    color:#bec9c3;
    background-color:#2a2a2a;
}
/* 鼠标悬浮 */
QPushButton:hover{
	border:1px solid #82d7ba;
    border-color:#66a8ff;
    background-color:#393939;
}
/* 选中状态 核心 */
QPushButton:checked{
    border:1px solid #2196F3;
    background-color:#82d7ba;
    color:#ffffff;
}
/* 点击按压 */
QPushButton:pressed{
    background-color:#82d7ba;
}</string>
